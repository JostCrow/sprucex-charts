  "title": "Area Ramp",
  "subtitle": "Layered area chart with soft opacity.",
  "series": [
    {
      "id": "revenue",
      "name": "Revenue",
      "xKey": "month",
      "yKey": "revenue",
      "areaOpacity": 0.25
    }
  ],
  "axes": {
    "x": {
      "scaleType": "category"
    },
    "y": {
      "grid": true
    }
