const options = {
  title: "Line Trend",
  subtitle: "Single-series line chart over shared category steps.",
  series: [
    {
      id: "revenue",
      name: "Revenue",
      xKey: "month",
      yKey: "revenue",
    },
  ],
  axes: {
    x: {
      scaleType: "category",
