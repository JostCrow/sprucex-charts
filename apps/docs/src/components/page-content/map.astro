---
import StaticChartExample from "../StaticChartExample.astro";

const data = [
  { id: "SE", marker: "SE", value: 88 },
  { id: "US", marker: "US", value: 54 },
  { id: "DE", marker: "DE", value: 97 },
  { id: "IN", marker: "IN", value: 73 },
  { id: "BR", marker: "BR", value: 62 },
  { id: "AU", marker: "AU", value: 49 },
  { id: "ZA", marker: "ZA", value: 67 },
  { id: "JP", marker: "JP", value: 91 },
  { id: "CA", marker: "CA", value: 58 },
  { id: "MX", marker: "MX", value: 45 },
];

const options = {
  title: "Global Performance",
  subtitle:
    "Responsive world map using built-in geometry, ISO country matching, and marker overlays.",
  series: [
    {
      id: "countries",
      name: "Countries",
      xKey: "id",
      valueKey: "value",
      color: "#e4602b",
    },
  ],
  legend: {
    enabled: false,
  },
  padding: 24,
  map: {
    source: "world",
    projection: "equal-earth",
    valueKey: "value",
  },
};
---

<StaticChartExample
  chartType="map"
  data={data}
  options={options}
  containerClass="w-full h-[clamp(20rem,62vh,42rem)]"
/>
