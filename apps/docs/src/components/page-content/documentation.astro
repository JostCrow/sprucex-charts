                  pie, scatter, bubble, histogram, combo, multi-axis,
                  heatmap, box-plot, radar, treemap, sankey, funnel, gauge,
                  polar, candlestick, ohlc, map
                </div>
              </td>
              <td class="whitespace-normal">
                <div>line</div>
              </td>
              <td class="whitespace-normal">
                <div>
