              </td>
              <td class="whitespace-normal">-</td>
              <td class="whitespace-normal">
                <div>&#123;&#125;</div>
              </td>
              <td class="whitespace-normal">
                <div>
                  Nested configuration object. The integration strips out data
                  and type from this object before rendering.
                </div>
              </td>
            </tr>
