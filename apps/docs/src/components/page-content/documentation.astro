              </td>
              <td class="whitespace-normal">
                <div>expression -&gt; array&lt;object&gt; | object</div>
              </td>
              <td class="whitespace-normal">—</td>
              <td class="whitespace-normal">
                <div>required; falls back to []</div>
              </td>
              <td class="whitespace-normal">
                <div>
                  The SpruceX expression or literal that resolves to chart data.
                  Non-object results are treated as an empty dataset.
                </div>
              </td>
            </tr>
            <tr data-setting-row>
              <td class="whitespace-normal">
                <div>
