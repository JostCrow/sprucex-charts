---
import StaticChartExample from "../StaticChartExample.astro";

const data = [
  {
    "value": 87
  }
];
const options = {
  "title": "System Health",
  "subtitle": "Gauge charts can use target trendlines as goal markers.",
  "series": [
    {
      "id": "gauge",
      "name": "Uptime",
      "valueKey": "value"
    }
  ],
  "axes": {
    "y": {
      "min": 0,
      "max": 100
    }
  },
  "trendlines": [
    {
      "id": "goal",
      "type": "target",
      "value": 95,
      "label": "Goal"
    }
  ]
};
---

<StaticChartExample
  chartType="gauge"
  data={data}
  options={options}
/>
