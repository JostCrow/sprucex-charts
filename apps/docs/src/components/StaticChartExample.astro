---
interface Props {
  chartType: string;
  data: unknown;
  minHeightClass?: string;
  containerClass?: string;
  options?: Record<string, unknown>;
}

const {
  chartType,
  data,
  minHeightClass = "min-h-112",
  containerClass,
  options = {},
} = Astro.props;

const defaultMarkerSize = (series: Record<string, unknown>) => {
  const seriesType =
    typeof series.type === "string" && series.type.length > 0
      ? series.type
      : chartType;
  return seriesType === "line" ||
    seriesType === "area" ||
    seriesType === "stacked-area"
    ? 0
    : 5;
};

const normalizedOptions = {
  ...options,
  series: Array.isArray(options.series)
    ? options.series.map((series) => {
        if (!series || typeof series !== "object") {
          return series;
        }

        return {
          ...series,
          strokeWidth:
            "strokeWidth" in series && series.strokeWidth != null
              ? series.strokeWidth
              : 3,
          markerSize:
            "markerSize" in series && series.markerSize != null
              ? series.markerSize
              : defaultMarkerSize(series),
        };
      })
    : options.series,
};

const sxData = JSON.stringify({
  data,
  options: normalizedOptions,
});

const resolvedContainerClass = containerClass ?? `${minHeightClass} w-full`;
---

<section>
  <div
    class={resolvedContainerClass}
    sx-data={sxData}
    sx-chart="data"
    sx-chart-type={chartType}
    sx-chart-options="options"
  ></div>
</section>
