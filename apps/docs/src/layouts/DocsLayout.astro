---
import DocsSidebar from "../components/DocsSidebar.astro";
import DocsPageHeader from "../components/DocsPageHeader.astro";
import type { DocPage } from "../data/docs";

interface Props {
  page: DocPage;
}

const { page } = Astro.props;

import '../styles.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>{page.browserTitle}</title>
    <script is:inline>
      (() => {
        try {
          const themeStore = JSON.parse(
            localStorage.getItem("sprucex-store-theme") || "{}",
          );
          const legacy = JSON.parse(localStorage.getItem("darkMode") || "{}");
          const isDark =
            typeof themeStore.dark === "boolean"
              ? themeStore.dark
              : Boolean(legacy.darkMode);
          if (isDark) {
            document.documentElement.classList.add("dark");
          }
        } catch {
          // Ignore storage access errors.
        }
      })();
    </script>
    <script defer src="/vendor/basecoat/basecoat.min.js"></script>
    <script defer src="/vendor/basecoat/sidebar.min.js"></script>
    <script defer src="/vendor/sprucex.js"></script>
    <script defer src="/vendor/sprucex-charts.js"></script>
  </head>
  <body sx-page>
    <div
      class="min-h-screen bg-background text-foreground"
      sx-data="docsPage"
    >
      <DocsSidebar currentFile={page.slug} />
      <main {...(page.mainAttributes ?? {})} class="px-6 py-8 md:px-16 md:py-12 flex flex-col gap-4">
        <button
          type="button"
          class="btn-outline w-fit"
          aria-controls="docs-sidebar"
          aria-label="Toggle navigation"
          sx-on:click="$dispatch('basecoat:sidebar', { id: 'docs-sidebar' })"
        >
          Navigation
        </button>
        <DocsPageHeader page={page} />
        <slot />
      </main>
    </div>
    <script is:inline>
      (() => {
        const bootDocsSpruceX = () => {
          if (window.__docsSpruceXBooted || !window.SpruceX) return;
          window.__docsSpruceXBooted = true;

          const root = document.documentElement;
          const theme = window.SpruceX.store(
            "theme",
            { dark: root.classList.contains("dark") },
            { persist: true, syncTabs: true },
          );

          window.SpruceX.effect(() => {
            root.classList.toggle("dark", Boolean(theme.dark));
          });

          window.SpruceX.data("docsPage", () => ({
            toggleTheme() {
              theme.dark = !theme.dark;
            },
          }));

          window.SpruceX.data("docsDocs", () => ({
            searchQuery: "",
            visibleCount: 1,
            filterSettings(container) {
              const query = String(this.searchQuery || "").trim().toLowerCase();
              const scope = container || document;
              const rows = scope.querySelectorAll("[data-setting-row]");
              let count = 0;
              rows.forEach((row) => {
                const text = (row.textContent || "").toLowerCase();
                const isVisible = !query || text.includes(query);
                row.style.display = isVisible ? "" : "none";
                if (isVisible) count += 1;
              });
              this.visibleCount = count;
            },
          }));

          document.addEventListener("basecoat:theme", () => {
            theme.dark = !theme.dark;
          });

          const reinitSidebar = () => {
            if (window.basecoat && typeof window.basecoat.init === "function") {
              window.basecoat.init("sidebar");
            }
          };

          document.addEventListener("sprucex:page-after", () => {
            queueMicrotask(reinitSidebar);
          });
          window.addEventListener("load", reinitSidebar, { once: true });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", bootDocsSpruceX, {
            once: true,
          });
        } else {
          bootDocsSpruceX();
        }
      })();
    </script>
  </body>
</html>
